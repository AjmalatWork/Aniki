<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- Dev only: server/ runs plain HTTP locally in this slice. 10.0.2.2 is the emulator's
         alias for the host machine; 127.0.0.1 is used on a physical device tunneled via
         `adb reverse`. Do not extend this to a broader cleartext allowance. -->
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">10.0.2.2</domain>
        <domain includeSubdomains="false">127.0.0.1</domain>
    </domain-config>
</network-security-config>
