GEMINI_API_KEY=
PORT=4000
# Optional: overrides the default Flash model (gemini-3.5-flash), e.g. if it's
# temporarily overloaded on Google's side. gemini-3.1-flash-lite is a known-good fallback.
GEMINI_MODEL=

# `docker compose up -d` at the repo root brings up this Postgres instance.
DATABASE_URL=postgres://aniki:aniki_dev_password@localhost:5432/aniki

# Path to the Firebase Admin service-account JSON (Project settings > Service accounts >
# Generate new private key in the Firebase console). Never commit the file itself.
FIREBASE_SERVICE_ACCOUNT_PATH=

# Local-dev only: when true, /sync trusts an X-Debug-Uid header instead of a real Firebase ID
# token. Must be unset/false once FIREBASE_SERVICE_ACCOUNT_PATH is configured.
AUTH_DEV_BYPASS=false

# Safety net against a runaway client loop blowing through Gemini quota unnoticed — counts
# actual Gemini calls only (cache hits are free). Defaults to 500/day if unset.
DAILY_GEMINI_CALL_CAP=500
